<?xml version="1.0" encoding="UTF-8"?>
<!-- Accessibility and i18n issues are errors (also set in build-logic AndroidCommon.kt). -->
<lint>
    <issue id="ContentDescription" severity="error" />
    <issue id="HardcodedText" severity="error" />
    <issue id="SetTextI18n" severity="error" />
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <issue id="MissingQuantity" severity="error" />
    <issue id="RtlHardcoded" severity="error" />
    <issue id="LabelFor" severity="error" />
    <issue id="KeyboardInaccessibleWidget" severity="error" />
    <issue id="ClickableViewAccessibility" severity="error" />
    <issue id="TouchTargetSizeCheck" severity="error" />
    <!-- Version-freshness checks make the build depend on the date; Renovate/Dependabot handle updates. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
</lint>
