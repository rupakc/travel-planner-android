    <string name="search_import_example_lisbon_label">48 hours in Lisbon</string>
    <string name="search_import_example_lisbon">48 hours in Lisbon: lunch at Time Out Market, Belém Tower and custard tarts at Pastéis de Belém, browse LX Factory, sunset at Miradouro da Senhora do Monte, then a day trip to Pena Palace in Sintra.</string>
    <string name="search_import_example_tokyo_label">A friend\'s Tokyo tips</string>
    <string name="search_import_example_tokyo">Tokyo musts from my trip!! Tsukiji Outer Market for breakfast, teamLab Planets (book ahead), Senso-ji at dawn before the crowds, drinks in Golden Gai, and Shibuya Sky at sunset. If you have time, Hakone for the onsen.</string>
    <string name="search_import_example_rome_label">Rome and Florence</string>
    <string name="search_import_example_rome">Day 1–2 Rome: Colosseum, dinner in Trastevere, the Pantheon, gelato at Giolitti. Day 3–4 Florence: the Uffizi, climb the Duomo, Piazzale Michelangelo at sunset and lunch at Mercato Centrale.</string>
