<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Shares exported .ics files with calendar / mail apps (authority = PlatformExport.authority). -->
        <provider
            android:name=".export.PlanExportFileProvider"
            android:authorities="${applicationId}.plan.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/plan_export_paths" />
        </provider>
    </application>

    <!-- Calendar inserts and share sheets are resolved through these intents on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>
</manifest>
