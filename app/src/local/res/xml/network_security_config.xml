<?xml version="1.0" encoding="utf-8"?>
<!-- local flavour: cleartext HTTP allowed for the local backend (emulator 10.0.2.2, LAN IPs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
