<?xml version="1.0" encoding="utf-8"?>
<!-- The session token, caches and the telemetry anon id / consent choice never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="file" path="datastore/last_location.preferences_pb" />
        <exclude domain="file" path="datastore/telemetry.preferences_pb" />
        <exclude domain="database" path="travel-planner.db" />
        <exclude domain="database" path="travel-planner.db-wal" />
        <exclude domain="database" path="travel-planner.db-shm" />
        <exclude domain="sharedpref" path="tp_keys.xml" />
        <exclude domain="sharedpref" path="alert_poll.xml" />
        <exclude domain="sharedpref" path="trip_reminders.xml" />
        <exclude domain="sharedpref" path="nearby_notifications.xml" />
        <exclude domain="sharedpref" path="push_registration.xml" />
        <exclude domain="sharedpref" path="server_capabilities.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="file" path="datastore/last_location.preferences_pb" />
        <exclude domain="file" path="datastore/telemetry.preferences_pb" />
        <exclude domain="database" path="travel-planner.db" />
        <exclude domain="database" path="travel-planner.db-wal" />
        <exclude domain="database" path="travel-planner.db-shm" />
        <exclude domain="sharedpref" path="tp_keys.xml" />
        <exclude domain="sharedpref" path="alert_poll.xml" />
        <exclude domain="sharedpref" path="trip_reminders.xml" />
        <exclude domain="sharedpref" path="nearby_notifications.xml" />
        <exclude domain="sharedpref" path="push_registration.xml" />
        <exclude domain="sharedpref" path="server_capabilities.xml" />
    </device-transfer>
</data-extraction-rules>
